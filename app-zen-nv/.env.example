# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/gestao_zen?schema=public"

# Autenticação (NextAuth) - gere um valor aleatório e seguro
NEXTAUTH_SECRET="troque-por-uma-chave-secreta-longa"
NEXTAUTH_URL="http://localhost:3000"

# Google Analytics (opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# SMTP / E-mail (opcional - usado para envio de relatórios agendados)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="GESTÃO ZEN"

# AWS S3 (opcional - usado para armazenamento de arquivos)
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""
